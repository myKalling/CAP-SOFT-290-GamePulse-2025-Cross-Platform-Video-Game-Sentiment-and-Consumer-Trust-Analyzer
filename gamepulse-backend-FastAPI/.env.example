# Defaults target a local SQL Server default instance named GamePulse.
# The current Windows user must have permission to access the database.
GAMEPULSE_SQL_SERVER=localhost
GAMEPULSE_SQL_DATABASE=GamePulse
GAMEPULSE_SQL_DRIVER=ODBC Driver 18 for SQL Server

# For SQL Server authentication, set both values and omit neither.
# GAMEPULSE_SQL_USER=
# GAMEPULSE_SQL_PASSWORD=
