{"id": 25406, "slug": "fantasy-aquarium", "name": "Fantasy Aquarium", "name_original": "Fantasy Aquarium", "description": "<p>Fantasy Aquarium is a casual simulation game that offers card pack openings,capsule toys, and other engaging activities. Players collect fish cards to complete their fantasy fish box. </p><h3> Game Features </h3><p>· The adorable Kanban girl is consistently present by your side.</p><p>· Cultivate your own fry in meticulously designed tanks; as they mature, players can choose to exchange them for gold coins or keep them for regular fixed coin rewards.</p><p>· Unlock various themed fish boxes to discover hidden fish and decorations!</p><p>· Enjoy a diverse selection of soothing background music with ambient sounds, perfect for unwinding after work or study.</p>", "metacritic": null, "metacritic_platforms": [], "released": "2008-02-26", "tba": false, "updated": "2024-11-25T06:59:41", "background_image": "https://media.rawg.io/media/screenshots/b37/b37131f41a8654f2948a6ebf26806ee2.jpg", "background_image_additional": "https://media.rawg.io/media/screenshots/0e8/0e88e9d6a3f7507d58f5aaabf97125a1.jpg", "website": "", "rating": 0.0, "rating_top": 0, "ratings": [], "reactions": null, "added": 4, "added_by_status": {"owned": 3, "beaten": 1}, "playtime": 0, "screenshots_count": 6, "movies_count": 0, "creators_count": 0, "achievements_count": 0, "parent_achievements_count": 0, "reddit_url": "", "reddit_name": "", "reddit_description": "", "reddit_logo": "", "reddit_count": 0, "twitch_count": 0, "youtube_count": 0, "reviews_text_count": 0, "ratings_count": 0, "suggestions_count": 239, "alternative_names": [], "metacritic_url": "", "parents_count": 0, "additions_count": 0, "game_series_count": 0, "user_game": null, "reviews_count": 0, "community_rating": 0, "saturated_color": "0f0f0f", "dominant_color": "0f0f0f", "parent_platforms": [{"platform": {"id": 1, "name": "PC", "slug": "pc"}}, {"platform": {"id": 7, "name": "Nintendo", "slug": "nintendo"}}], "plat