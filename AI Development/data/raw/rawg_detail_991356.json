anguage": "eng", "games_count": 3235, "image_background": "https://media.rawg.io/media/games/ceb/ceb68aef14fbe54f0610acd8de480f64.jpg"}, {"id": 45201, "name": "Remote Play Together", "slug": "remote-play-together", "language": "eng", "games_count": 4099, "image_background": "https://media.rawg.io/media/screenshots/f72/f728954e667e580ba2ac507db226ae48.jpg"}, {"id": 140, "name": "Hidden Object", "slug": "hidden-object", "language": "eng", "games_count": 5832, "image_background": "https://media.rawg.io/media/games/d0c/d0cfde21933c9075e793d6cc0c49c91d.jpg"}, {"id": 46112, "name": "Shared/Split Screen Co-op", "slug": "sharedsplit-screen-co-op", "language": "eng", "games_count": 2652, "image_background": "https://media.rawg.io/media/games/355/355d2ec5d6b87518228dc30a9bb0e70d.jpg"}, {"id": 326, "name": "Investigation", "slug": "investigation", "language": "eng", "games_count": 3450, "image_background": "https://media.rawg.io/media/screenshots/e94/e9403b3e50ac044b44f39f91dce23b85.jpg"}, {"id": 46114, "name": "Shared/Split Screen PvP", "slug": "sharedsplit-screen-pvp", "language": "eng", "games_count": 2972, "image_background": "https://media.rawg.io/media/games/dfe/dfe14d30ed6fccd9db4ae79d3be51d54.jpg"}, {"id": 55318, "name": "Party Game", "slug": "party-game-2", "language": "eng", "games_count": 456, "image_background": "https://media.rawg.io/media/screenshots/111/111dd0db748d5361c8a60bc26063b050.jpg"}], "publishers": [{"id": 80143, "name": "Dodo Tako", "slug": "dodo-tako", "games_count": 1, "image_background": "https://media.rawg.io/media/screenshots/73d/73d4267233a29d73c5a8b95163a51f55.jpg"}], "esrb_rating": null, "clip": null, "description_raw": "It's mischief night at Billy’s haunted mansion, and the host has quite the challenge in mind for all the monstrous guests! Partake in a hide-and-seek competition with an original twist: you don't know who you are, and the only place to hide is within the crowd. Can you find yourself in the sea of monsters and prove you’re the sneakiest, most perceptive player of all?\nKey Features\nIntuitive Multiplayer Gameplay : Jump into an easy to learn, yet hard to master hide-and-seek experience where discovering your own identity is just as crucial as uncovering your opponents.\nDiverse Game Modes : Enjoy a variety of game modes, whether you prefer team-based or competitive challenges, each with its own set of roles and objectives.\nFlexible Play Options : Play locally or online with 2 to 8 players, offering endless fun whether you’re hosting a party or joining one.\nDiscreetly figure out who you are, complete your objectives, and seek out other players—all while staying in character and avoiding detection.\nEach game mode introduces distinct roles with specific objectives. Strive for the highest score and earn bragging rights on the endgame leaderboard that showcases each player’s performance.\nWhere is Billy? is for 2 to 8 players, either locally or online. Easily connect to other lobbies or open your own to fill up the party and keep the fun going through the matchmaking system."}