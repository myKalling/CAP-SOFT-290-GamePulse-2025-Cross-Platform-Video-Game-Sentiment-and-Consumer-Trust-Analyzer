nt": 3764, "image_background": "https://media.rawg.io/media/games/1f7/1f73ddf4231f9296d73358ddd5d54e29.jpg"}, {"id": 45201, "name": "Remote Play Together", "slug": "remote-play-together", "language": "eng", "games_count": 4099, "image_background": "https://media.rawg.io/media/screenshots/f72/f728954e667e580ba2ac507db226ae48.jpg"}, {"id": 235, "name": "Trading Card Game", "slug": "trading-card-game", "language": "eng", "games_count": 653, "image_background": "https://media.rawg.io/media/games/bf5/bf57458ef8360854c8bb3599a42ef58f.jpg"}, {"id": 14194, "name": "deckbuilding", "slug": "deckbuilding", "language": "eng", "games_count": 1997, "image_background": "https://media.rawg.io/media/screenshots/74b/74ba3e337f2c3eed2858e3f37e2e69a6.jpg"}, {"id": 49950, "name": "Card Battler", "slug": "card-battler", "language": "eng", "games_count": 1821, "image_background": "https://media.rawg.io/media/games/180/180b7362cc5ae93a90bee70194916a0a.jpg"}, {"id": 49968, "name": "Auto Battler", "slug": "auto-battler", "language": "eng", "games_count": 1094, "image_background": "https://media.rawg.io/media/screenshots/e18/e1892646eac7bc3f3ac911f1df031ed2.jpg"}, {"id": 58271, "name": "Автобаттлер", "slug": "avtobattler", "language": "eng", "games_count": 1065, "image_background": "https://media.rawg.io/media/screenshots/831/8314e3bcda7acc77e4b356b0b0a315f2.jpg"}, {"id": 55322, "name": "Roguelike Deckbuilder", "slug": "roguelike-deckbuilder", "language": "eng", "games_count": 516, "image_background": "https://media.rawg.io/media/screenshots/489/4897ccb31411911c6c05f7b1725d751a.jpg"}, {"id": 49965, "name": "Traditional Roguelike", "slug": "traditional-roguelike-2", "language": "eng", "games_count": 454, "image_background": "https://media.rawg.io/media/screenshots/c41/c4157c05e1df370112db6cca9d2db1fc.jpg"}], "publishers": [{"id": 82797, "name": "Call of Clans", "slug": "call-of-clans", "games_count": 1, "image_background": "https://media.rawg.io/media/screenshots/899/8991931cb3bffae0239c8acfe19ebefb.jpg"}], "esrb_rating": null, "clip": null, "description_raw": "Call of Clans is an online turn-based strategy card game set in a Western fantasy world. You can build a dynamic and strategic deck using minion cards and skill cards to challenge equally matched opponents in a world of swords and magic. You can also team up with other players to tackle highly challenging co-op dungeons.Game FeaturesDeck Building: Players can construct their decks using minion cards and skill cards. Minion cards are categorized into Normal, Elite, and Hero. Normal cards can be deployed up to 2 copies, while others can only be deployed once. Each deck can contain up to 30 cards, including both minion and skill cards.Gameplay: Players battle on a 3x10 grid, taking turns to move until the opponent’s or their own commander is defeated.Classes: Players can freely choose between four classes: Knight, Mage, Priest, and Hunter. Each deck can only use cards from a single class.Ladder Competition: Once the Tiani Arena is unlocked, you can compete against other players in thrilling matches. The ladder is reset each season, and based on the players’ ranking points, top players will earn not only prestige but also generous seasonal rewards.Team Mode: After unlocking team dungeons, you can team up with other players to challenge high-difficulty dungeons. Dungeons come in three difficulty levels: Easy, Normal, and Hard. The higher the difficulty, the greater the rewards."}