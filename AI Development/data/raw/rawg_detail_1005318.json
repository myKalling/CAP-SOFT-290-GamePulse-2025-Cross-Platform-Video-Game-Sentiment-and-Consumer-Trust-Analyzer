mes/b45/b45575f34285f2c4479c9a5f719d972e.jpg"}, {"id": 149, "name": "Third Person", "slug": "third-person", "language": "eng", "games_count": 14851, "image_background": "https://media.rawg.io/media/games/ee3/ee3e10193aafc3230ba1cae426967d10.jpg"}, {"id": 117, "name": "Mystery", "slug": "mystery", "language": "eng", "games_count": 16651, "image_background": "https://media.rawg.io/media/games/5c0/5c0dd63002cb23f804aab327d40ef119.jpg"}, {"id": 110, "name": "Cinematic", "slug": "cinematic", "language": "eng", "games_count": 3437, "image_background": "https://media.rawg.io/media/games/c50/c5085506fe4b5e20fc7aa5ace842c20b.jpg"}, {"id": 218, "name": "Multiple Endings", "slug": "multiple-endings", "language": "eng", "games_count": 11724, "image_background": "https://media.rawg.io/media/games/618/618c2031a07bbff6b4f611f10b6bcdbc.jpg"}, {"id": 90, "name": "Visual Novel", "slug": "visual-novel", "language": "eng", "games_count": 10160, "image_background": "https://media.rawg.io/media/games/264/2642b17a7885f7abc4fd018e98943242.jpg"}, {"id": 209, "name": "Drama", "slug": "drama", "language": "eng", "games_count": 5997, "image_background": "https://media.rawg.io/media/games/615/61503312a95d451198d80d9bae275f79.jpg"}, {"id": 217, "name": "Romance", "slug": "romance", "language": "eng", "games_count": 9928, "image_background": "https://media.rawg.io/media/games/a6c/a6ccd34125c594abf1a9c9821b9a715d.jpg"}, {"id": 205, "name": "Lore-Rich", "slug": "lore-rich", "language": "eng", "games_count": 2284, "image_background": "https://media.rawg.io/media/games/007/0073b6418763a47eb023fba88cb22e7c.jpg"}, {"id": 572, "name": "Emotional", "slug": "emotional", "language": "eng", "games_count": 4650, "image_background": "https://media.rawg.io/media/games/6a2/6a2e48933245e2cd3c92248c75c925e1.jpg"}, {"id": 91686, "name": "Family Sharing", "slug": "family-sharing", "language": "eng", "games_count": 30523, "image_background": "https://media.rawg.io/media/screenshots/68b/68bcfe02c9b9b7123edab7ecce3f2660.jpg"}, {"id": 222, "name": "Choose Your Own Adventure", "slug": "choose-your-own-adventure", "language": "eng", "games_count": 5207, "image_background": "https://media.rawg.io/media/screenshots/b9c/b9cb8c4e69907a68e33a4ebb2580f82a.jpg"}, {"id": 160, "name": "Dating Sim", "slug": "dating-sim", "language": "eng", "games_count": 6869, "image_background": "https://media.rawg.io/media/games/39c/39ce4d47f0be643164a94e5a22f199df.jpg"}, {"id": 288, "name": "Interactive Fiction", "slug": "interactive-fiction", "language": "eng", "games_count": 5117, "image_background": "https://media.rawg.io/media/games/e0f/e0f8d58079f6a0c6afb25d91422a98fc.jpg"}, {"id": 285, "name": "Psychological", "slug": "psychological", "language": "eng", "games_count": 2881, "image_background": "https://media.rawg.io/media/games/003/0033ae7d21418ff5a7807ab2c7d90247.jpg"}, {"id": 231, "name": "Strategy RPG", "slug": "strategy-rpg", "language": "eng", "games_count": 3412, "image_background": "https://media.rawg.io/media/games/389/389355994024b6b2a2becd960e13b5b1.jpg"}, {"id": 151, "name": "Modern", "slug": "modern", "language": "eng", "games_count": 2325, "image_background": "https://media.rawg.io/media/games/734/7342a1cd82c8997ec620084ae4c2e7e4.jpg"}, {"id": 290, "name": "FMV", "slug": "fmv", "language": "eng", "games_count": 915, "image_background": "https://media.rawg.io/media/screenshots/d53/d536a8a449966ec8b944b2a53c2bef52.jpg"}, {"id": 66536, "name": "Романтика", "slug": "romantika", "language": "eng", "games_count": 4572, "image_background": "https://media.rawg.io/media/games/273/2733ce205ad3c4bf257ddea088de1621.jpg"}, {"id": 91814, "name": "FMV-игра", "slug": "fmv-igra", "language": "eng", "games_count": 277, "image_background": "https://media.rawg.io/media/screenshots/cb4/cb41216dfe4acd38b5016534934ef41f.jpg"}], "publishers": [{"id": 87416, "name": "前方工作室", "slug": "qian-fang-gong-zuo-shi", "games_count": 1, "image_background": "https://media.rawg.io/media/screenshots/4ac/4ac82565dd3a48ee5c24a218703ad8be.jpg"}], "esrb_rating": null, "clip": null, "description_raw": "首款情感反诈互动影游，由香港导演胡耀辉执导。扮演“情感猎手”，面对“捞女”组织，在非第一人称沉浸式影像中，在欺骗与诱惑之间做出关键抉择。\n游戏包含472分钟影像素材、200+选项、 38个结局。提供标准/大师双模式。一次购买，完整体验，无任何内购及额外付费。      我们是一群「普信」的创作者：平凡普通，但依然怀有信念——相信自己，相信伙伴的力量，相信正义终将胜利。这份信念，驱动我们想做个真正有现实意义的作品。很幸运，我们遇到了有着同样信念，又洞悉情感博弈、深谙人性复杂的胡耀辉导演，共同决定：别人不敢碰的话题，我们来做；别人讳莫如深的现实，我们来揭示！这款游戏，通过互动叙事，让你亲身体验并拆解精心设计的「情感陷阱」，洞悉隐于日常的「情感操控」。在这个虚构的复仇故事中，看清现实中的套路与算计，找到保护自己的方法。我们坚信，揭露问题，才有改变的可能。我们想和你并肩站在一起，共同谋求一个改变。\n在这里，甜蜜的伪装下是精心计算的陷阱，温柔试探的背后藏着贪婪的匕首。你将扮演主角吴宇伦，一个曾被“捞女”伤透，决心以身为饵，反击捞女组织的“情感猎手”。步入这个以爱为名的灰色地带，周旋于数位外表光鲜、手段高明的女性角色之间，体验一场步步紧逼的情感围猎。有善良可怜的新人主播，有糖衣包装的甜美模特，更有玩弄舆论的知名博主，面冷心狠的黑手套，乃至那个深不可测的幕后操盘手！这不是轻松的恋爱模拟，而是步步惊心、充满拉扯与博弈的考验。你，是会成为「猎人」，还是沦为「猎物」？    在这个欲望与谎言交织的猎场，“捞”与“被捞”的界限模糊，“复仇”的火焰随时可能引火烧身。你将在人性的钢丝上行走，在道德的灰色地带起舞。每一次对话都是情感的博弈，每一次行动都是利用人性的周旋。你将如何抉择？是跟随“常识”付出心血，还是“以毒攻毒”还施彼身。超过200+抉择，不仅决定剧情走向，更可能悄然影响着「沉沦值」—这份足以致命的吸引，将直接导向不同结局。38种结局在你眼前铺开：是成功复仇、救赎他人？是身败名裂、一同沉沦？还是与某些“敌人”达成禁忌的和解？命运的骰子，已掷入你手中。\n"}