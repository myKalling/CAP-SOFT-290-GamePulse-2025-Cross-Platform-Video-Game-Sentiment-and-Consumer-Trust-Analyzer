_count": 10, "image_background": "https://media.rawg.io/media/games/a95/a95ef312fc2376efeb477f79d7dcea7e.jpg"}, {"id": 675, "name": "creatures", "slug": "creatures", "language": "eng", "games_count": 269, "image_background": "https://media.rawg.io/media/games/5fc/5fcf14833f26f3546cdf0da703d28cde.jpg"}, {"id": 5459, "name": "key", "slug": "key", "language": "eng", "games_count": 656, "image_background": "https://media.rawg.io/media/games/c30/c30ed134d1b67e06f2171cd8bd66cdd9.jpg"}, {"id": 91968, "name": "Compartilhamento em família", "slug": "compartilhamento-em-familia", "language": "eng", "games_count": 9, "image_background": "https://media.rawg.io/media/games/69b/69bb7cc65186b07978fd173138bb02ad.jpg"}, {"id": 92338, "name": "Controles de volume independentes", "slug": "controles-de-volume-independentes", "language": "eng", "games_count": 3, "image_background": "https://media.rawg.io/media/games/69b/69bb7cc65186b07978fd173138bb02ad.jpg"}, {"id": 92339, "name": "Dificuldade ajustável", "slug": "dificuldade-ajustavel", "language": "eng", "games_count": 2, "image_background": "https://media.rawg.io/media/screenshots/11a/11a8b0ff815d13d67031286af58d0b21.jpg"}, {"id": 92341, "name": "Som estéreo", "slug": "som-estereo", "language": "eng", "games_count": 3, "image_background": "https://media.rawg.io/media/games/69b/69bb7cc65186b07978fd173138bb02ad.jpg"}, {"id": 92349, "name": "Salvamento a qualquer momento", "slug": "salvamento-a-qualquer-momento", "language": "eng", "games_count": 2, "image_background": "https://media.rawg.io/media/screenshots/47e/47e801c7149bc77c7fd6288312eb6d07.jpg"}, {"id": 92350, "name": "Opções de legendas", "slug": "opcoes-de-legendas", "language": "eng", "games_count": 1, "image_background": "https://media.rawg.io/media/games/69b/69bb7cc65186b07978fd173138bb02ad.jpg"}], "publishers": [{"id": 13997, "name": "PQube", "slug": "pqube", "games_count": 113, "image_background": "https://media.rawg.io/media/screenshots/713/7138f3b69ffc5614d859fb0e3a08dec6.jpg"}], "esrb_rating": {"id": 4, "name": "Mature", "slug": "mature"}, "clip": null, "description_raw": "Caroline Walker is back in the sequel to the award-winning classic survival horror. Stalk the halls of haunting monasteries and other nightmarish locations. Brace yourself to confront terrifying creatures armed only with makeshift weapons as you desperately try to rescue your cursed sister.\nAfter the events of Wildberger Hospital, Caroline yearns for a normal life with her younger sister, Anna. However, fate has other plans. As Anna falls victim to a mysterious affliction, coughing blood and experiencing blackened eyes and moments of unconsciousness, conventional remedies prove futile. In a desperate bid to save her sister, Caroline must turn to the supernatural.\nAn All New Setting Filled With Unspeakable Horrors…\nWelcome to Puerto Miller, a remote Southern American town with a chilling past. Founded ages ago by the reclusive Ismuit tribe—a small religious group that shunned the outside world—the town conceals unspeakable horrors beneath its ancient exterior.\nCombat Terrifying Creatures With Makeshift Weapons\nFace pulse-pounding combat as you confront monstrous creatures using a range of ingenious makeshift weapons. Every corner may hide an enemy, so resource management is key to survival.\nSolve Mind-Bending Environmental-Based Puzzles\nUtilise logic and reasoning to forge connections between items found in the environment and the intricately designed puzzles. Creatively combine resources to unlock twisted enigmas and delve deeper into the dark mysteries that shroud your path."}