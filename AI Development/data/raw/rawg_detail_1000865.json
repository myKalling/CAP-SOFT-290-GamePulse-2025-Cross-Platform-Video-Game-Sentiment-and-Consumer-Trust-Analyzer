{"id": 1000865, "slug": "bunny-hurling", "name": "Bunny Hurling", "name_original": "Bunny Hurling", "description": "<strong>Track and hunt bunnies in the woods with your bow. It’s what the King demands.</strong><br/><br/><strong>Load the catapult and hurl them into the castle. No one will thank you.</strong><br/><br/><strong>Things tend to get stranger… and far more dangerous.</strong><br/><br/><strong>Do you think you can satisfy the King's desires? He’s not known for his mercy.</strong><h3>IN BUNNY HURLING, YOU CAN...</h3><ul><li><p>Move stealthily and wait for the perfect moment to <strong>shoot your arrow!</strong></p></li><li><p>Lure the bunnies with a <strong>bunny caller</strong>!</p></li><li><p>Beware of <strong>vengeful creatures and ghosts</strong>! You're not the only predator in the forest!</p></li><li><p>Freely explore a vast <strong>non-linear map</strong>, full of bunny curiosities and much more!</p></li></ul>", "metacritic": null, "metacritic_platforms": [], "released": "2025-04-03", "tba": false, "updated": "2025-04-07T07:57:54", "background_image": "https://media.rawg.io/media/screenshots/9d0/9d072a68e851b9e86dcf667809275348.jpg", "background_image_additional": "https://media.rawg.io/media/screenshots/079/07955006a1c757a5eff2fd36543e6e29.jpg", "website": "", "rating": 0.0, "rating_top": 0, "ratings": [], "reactions": null, "added": 4, "added_by_status": {"yet": 2, "owned": 1, "playing": 1}, "playtime": 0, "screenshots_count": 11, "movies_count": 0, "creators_count": 0, "achievements_count": 0, "parent_achievements_count": 0, "reddit_url": "", "reddit_name": "", "reddit_description": "", "reddit_logo": "", "reddit_count": 0, "twitch_count": 0, "youtube_count": 0, "reviews_text_count": 0, "ratings_count": 0, "suggestions_count": 396, "alternative_names": [], "metacritic_url": "", "parents_count": 0, "additions_count": 0, "game_series_count": 0, "user_game": null, "reviews_count": 0, "community_rating": 0, "saturated_color": "0f0f0f", "dominant_color"