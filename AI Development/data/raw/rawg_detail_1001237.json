{"id": 1001237, "slug": "waxweaver", "name": "waxweaver", "name_original": "waxweaver", "description": "<p>waxweaver is a short sandbox rpg game that takes place on a square planet. Explore the world, gather resources, build a home and become stronger. </p><p><strong>Features:</strong></p><ul><li><p>over 300 items to collect !</p></li><li><p>3 and a half bosses to take down !</p></li><li><p>a procedural world with unique square gravity !</p></li><li><p>cool and relaxing ambient tracks !</p></li><li><p>20 steam achievements for you to earn !</p></li><li><p>secret world generator types !</p></li><li><p>6-ish hours of content !</p></li><li><p>completely, entirely free !</p></li></ul><p>this game was developed over the course of all last year, making it the longest project I've ever worked on. special thanks to brandy from scarecrow arts for making the steam release possible. this project means a lot to me so id be very happy if u gave it a try :]</p>", "metacritic": null, "metacritic_platforms": [], "released": "2025-04-10", "tba": false, "updated": "2025-04-11T12:57:40", "background_image": "https://media.rawg.io/media/screenshots/8bd/8bd2f0a5c91d01ff9ad383dc803e8f75.jpg", "background_image_additional": "https://media.rawg.io/media/screenshots/026/0261a4a668bf60bcce167c068b6aafb4.jpg", "website": "https://kaiakairos.net/", "rating": 0.0, "rating_top": 0, "ratings": [], "reactions": null, "added": 4, "added_by_status": {"yet": 3, "toplay": 1}, "playtime": 0, "screenshots_count": 6, "movies_count": 0, "creators_count": 0, "achievements_count": 0, "parent_achievements_count": 0, "reddit_url": "", "reddit_name": "", "reddit_description": "", "reddit_logo": "", "reddit_count": 0, "twitch_count": 0, "youtube_count": 0, "reviews_text_count": 0, "ratings_count": 0, "suggestions_count": 143, "alternative_names": [], "metacritic_url": "", "parents_count": 0, "additions_count": 0, "game_series_count": 0, "user_game": null, "reviews_count": 0, "community_rating": 0, "saturated_co