mes_count": 16657, "image_background": "https://media.rawg.io/media/games/260/26023c855f1769a93411d6a7ea084632.jpeg"}, {"id": 166, "name": "Stylized", "slug": "stylized", "language": "eng", "games_count": 10494, "image_background": "https://media.rawg.io/media/games/566/566f53f43aa1bd28c63cf3a4d21440ee.jpg"}, {"id": 209, "name": "Drama", "slug": "drama", "language": "eng", "games_count": 5997, "image_background": "https://media.rawg.io/media/games/b0a/b0a370527fea0e824225269d4a8797db.jpg"}, {"id": 187, "name": "Demons", "slug": "demons", "language": "eng", "games_count": 3527, "image_background": "https://media.rawg.io/media/games/202/2023cb28ef354720a2ca4652727687d0.jpg"}, {"id": 59643, "name": "Протагонистка", "slug": "protagonistka", "language": "eng", "games_count": 8153, "image_background": "https://media.rawg.io/media/games/8cb/8cb8c54422636541fece8a479694f044.jpg"}, {"id": 236, "name": "Top-Down Shooter", "slug": "top-down-shooter", "language": "eng", "games_count": 3256, "image_background": "https://media.rawg.io/media/games/731/731576e935a2d50481812aab0e7ae9f6.jpg"}, {"id": 254, "name": "Spectacle fighter", "slug": "spectacle-fighter", "language": "eng", "games_count": 850, "image_background": "https://media.rawg.io/media/games/511/511995d5dfcf18965dbb354d2ba9e176.jpg"}, {"id": 40855, "name": "Un jugador", "slug": "un-jugador", "language": "eng", "games_count": 24, "image_background": "https://media.rawg.io/media/games/c97/c97aba78a97038867d4b32a81fe48567.jpg"}, {"id": 40841, "name": "Logros de Steam", "slug": "logros-de-steam", "language": "eng", "games_count": 21, "image_background": "https://media.rawg.io/media/games/c97/c97aba78a97038867d4b32a81fe48567.jpg"}, {"id": 83730, "name": "Compat. total con control", "slug": "compat-total-con-control", "language": "eng", "games_count": 8, "image_background": "https://media.rawg.io/media/games/51a/51a404b9918a0b19fc704a3ca248c69f.jpg"}, {"id": 91921, "name": "Préstamo familiar", "slug": "prestamo-familiar", "language": "eng", "games_count": 13, "image_background": "https://media.rawg.io/media/screenshots/b07/b07c67110f60e12cfc740fcbc6f8d961.jpg"}], "publishers": [{"id": 5010, "name": "Top Hat Studios", "slug": "top-hat-studios-inc", "games_count": 51, "image_background": "https://media.rawg.io/media/screenshots/774/774944057babee1392f217d3aafac9a7.jpg"}], "esrb_rating": null, "clip": null, "description_raw": "Embrassez votre démon intérieur ou laissez-vous consumer par lui.\n\n\nPolly, éternellement malchanceuse, s'échappe d'un orphelinat cauchemardesque... pour se retrouver piégée dans les enfers.\n\nLa ville était enveloppée d'un brouillard mortel. On dit que si vous voyez un tel signe, vous devez être prudent. Votre bracelet anti-brouillard s'illuminera en rouge lorsque le brouillard mortel sera très proche.\n\n\nVous rencontrerez les habitants du royaume des enfers, qui ne sont pas tous contre vous, mais dont aucun n'est de votre côté. Peu importe comment les événements se déroulent, n'oubliez jamais le serment et le pacte que vous avez conclus et qui vous ont plongé dans cet abîme.\n\n\nPréparez-vous à vivre une expérience de jeu unique, mêlant exploration du monde et combats en vue latérale et en vue de dessus. Des connaissances anciennes interdites renforceront votre puissance. À chaque nouveau sort maîtrisé, le pouvoir de Polly devient plus meurtrier.\n\n\nExplorez des royaumes inquiétants, affrontez des figures hantées du passé de Polly et maîtrisez des sorts interdits dans une lutte pour la liberté. Parviendrez-vous à vous échapper, ou le démon vous rattrapera-t-il avant ?"}