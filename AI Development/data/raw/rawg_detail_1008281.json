rawg.io/media/games/355/355d2ec5d6b87518228dc30a9bb0e70d.jpg"}, {"id": 46114, "name": "Shared/Split Screen PvP", "slug": "sharedsplit-screen-pvp", "language": "eng", "games_count": 2972, "image_background": "https://media.rawg.io/media/games/dfe/dfe14d30ed6fccd9db4ae79d3be51d54.jpg"}, {"id": 56825, "name": "2D-файтинг", "slug": "2d-faiting", "language": "eng", "games_count": 1470, "image_background": "https://media.rawg.io/media/games/d59/d595e078405821fb3f75dab4591d64af.jpg"}, {"id": 92228, "name": "Stereo Sound", "slug": "stereo-sound", "language": "eng", "games_count": 2157, "image_background": "https://media.rawg.io/media/screenshots/50c/50ca35b80bd7a35a1a7d9fecdbcd6517_kJS1cIB.jpg"}, {"id": 92227, "name": "Custom Volume Controls", "slug": "custom-volume-controls", "language": "eng", "games_count": 3920, "image_background": "https://media.rawg.io/media/games/c14/c148c1e52dac195fd28158834360fb97.jpg"}, {"id": 92225, "name": "Playable without Timed Input", "slug": "playable-without-timed-input", "language": "eng", "games_count": 4012, "image_background": "https://media.rawg.io/media/games/ffc/ffc03c98caaff1651237ffdabe57ec37.jpg"}, {"id": 92232, "name": "Keyboard Only Option", "slug": "keyboard-only-option", "language": "eng", "games_count": 1287, "image_background": "https://media.rawg.io/media/screenshots/a46/a46be79b008e9083c1da63454913edcf.jpg"}], "publishers": [{"id": 89073, "name": "Studio Bidou", "slug": "studio-bidou", "games_count": 1, "image_background": "https://media.rawg.io/media/screenshots/569/569c7d8bb0d7c2e05ecd5a14aca0fb39.jpg"}], "esrb_rating": null, "clip": null, "description_raw": "A fast-paced, easy to play, tiny platform fighter for 1-4 players, built to honor the era where stick fights ruled the internet! STYLE ON EVERYONE! We wanted A FEW QUICK MATCHES to feel like an old-school stick fight, which means flashy animations and impactful moments! To attain this feel, we made it so that most successful hits can be cancelled into air dashes, meaning your follow-up routes are nearly infinite. Deep-diving into this combo system is incredibly rewarding, and landing a well-executed chain of attacks feels uniquely satisfying. While this mechanic is not necessary to enjoy your battles, those who choose to embrace it will push the game to its limits!\n\n\n\n\nFIGHT ANYONE! We designed our game with online play in mind. A FEW QUICK MATCHES harnesses the amazing magic of ROLLBACK NETCODE to ensure smooth, lag-free battles across the internet. Host lobbies to challenge your friends,  or hop into quickplay to match up with any player in your region."}