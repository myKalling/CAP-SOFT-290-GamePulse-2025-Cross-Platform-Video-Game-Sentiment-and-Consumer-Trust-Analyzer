{"id": 41626, "slug": "routine", "name": "Routine", "name_original": "Routine", "description": "<p>ROUTINE is a First Person Sci-Fi Horror title set on an abandoned Lunar base designed around an 80’s vision of the future.</p>\n<p>Curious exploration turns into a need for survival when a lunar base goes completely quiet. Searching for answers puts you face to face with an enemy who is certain the main threat is you. Discoveries lead to deeper unknowns and the only way to go is forward.</p>\n<p>EXPLORE: Roam through contrasting sectors of the Lunar station, from abandoned malls to deteriorating Living Quarters.<br />\nIMMERSE: Full Body Awareness, Deadzone Aiming &amp; minimal UI help create a gripping and atmospheric experience.<br />\nUPGRADE: Discover modules that unlock new functionality for the Cosmonaut Assistance Tool (C.A.T.)<br />\nSURVIVE: Run, hide, or attempt to defend yourself using the C.A.T. as a last resort.</p>", "metacritic": null, "metacritic_platforms": [], "released": "2025-12-04", "tba": false, "updated": "2026-09-17T16:42:17", "background_image": "https://media.rawg.io/media/games/c2c/c2c572ae82b7631f482eb1bc84903fac.jpg", "background_image_additional": "https://media.rawg.io/media/screenshots/c28/c2888f9276592f14330a2a7ba5b95f8f.jpg", "website": "http://www.routinegame.com", "rating": 3.61, "rating_top": 4, "ratings": [{"id": 4, "title": "recommended", "count": 8, "percent": 34.78}, {"id": 3, "title": "meh", "count": 8, "percent": 34.78}, {"id": 5, "title": "exceptional", "count": 5, "percent": 21.74}, {"id": 1, "title": "skip", "count": 2, "percent": 8.7}], "reactions": {"4": 1, "9": 1}, "added": 127, "added_by_status": {"yet": 17, "owned": 23, "beaten": 15, "toplay": 55, "dropped": 15, "playing": 2}, "playtime": 3, "screenshots_count": 9, "movies_count": 0, "creators_count": 0, "achievements_count": 0, "parent_achievements_count": 0, "reddit_url": "", "reddit_name": "", "reddit_description": "", "reddit_logo": "", "reddit_count": 0, "twitch_c