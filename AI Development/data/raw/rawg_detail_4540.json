dsplit-screen-pvp", "language": "eng", "games_count": 2972, "image_background": "https://media.rawg.io/media/games/dfe/dfe14d30ed6fccd9db4ae79d3be51d54.jpg"}, {"id": 500, "name": "Solo", "slug": "solo", "language": "eng", "games_count": 1655, "image_background": "https://media.rawg.io/media/screenshots/ee8/ee8610ecaf643f53d66ba0704d6ddeef.jpg"}, {"id": 303, "name": "Text-Based", "slug": "text-based", "language": "eng", "games_count": 3711, "image_background": "https://media.rawg.io/media/games/2af/2af667f3886c61c4535f6c3fab2b46ac.jpeg"}, {"id": 1329, "name": "phone", "slug": "phone", "language": "eng", "games_count": 3364, "image_background": "https://media.rawg.io/media/screenshots/398/3981dd3e2d622c35361c63f98737be40.jpg"}, {"id": 55318, "name": "Party Game", "slug": "party-game-2", "language": "eng", "games_count": 456, "image_background": "https://media.rawg.io/media/screenshots/111/111dd0db748d5361c8a60bc26063b050.jpg"}, {"id": 2724, "name": "trivia", "slug": "trivia", "language": "eng", "games_count": 921, "image_background": "https://media.rawg.io/media/screenshots/c08/c0844314479e6a8a7604fafe991e1de2.jpg"}, {"id": 330, "name": "Spelling", "slug": "spelling", "language": "eng", "games_count": 379, "image_background": "https://media.rawg.io/media/screenshots/fcb/fcba93b2384ccf81794d41cbdd168c6a.jpg"}, {"id": 58139, "name": "Викторина", "slug": "viktorina", "language": "eng", "games_count": 397, "image_background": "https://media.rawg.io/media/screenshots/2b1/2b1f42bf3f3e6308acab4faeca9ed8aa.jpg"}, {"id": 92356, "name": "who wants to be a millionaire", "slug": "who-wants-to-be-a-millionaire-2", "language": "eng", "games_count": 33, "image_background": "https://media.rawg.io/media/screenshots/a84/a84c1d5a5021a0bfac22f87894704ae4.jpg"}], "publishers": [{"id": 1287, "name": "Microids", "slug": "microids-2", "games_count": 206, "image_background": "https://media.rawg.io/media/games/400/4002753ab3a1275bb1e46aa9fe2c3592.jpg"}], "esrb_rating": {"id": 2, "name": "Everyone 10+", "slug": "everyone-10-plus"}, "clip": null, "description_raw": "Gather all your knowledge and get the jackpot while avoiding all the trick questions facing you!\nTHOUSANDS OF QUESTIONS\nWith 15 questions to answer, it will become harder and harder to increase the prize fund: over 3,000 themed questions waiting to be answered (geographic, science, history, but also entertainment or arts) with a growing difficulty...\n6 iconic countries are represented in the game, each with its own set and with a batch of 2,000 dedicated questions: the United Kingdom, the USA, Spain, Italy, France and Germany!\nUnlock questions packs by collecting “Neurons” in practicing/playing solo or with friends.\nSelect the themes you want to practice to improve your general knowledge and increase the odds of winning the jackpot.\n“Family mode\"\":  has been specially created with children-tailored questions included, for the players to play as a family no matter how old they are.\nPLAY BATTLE ROYAL\nUp to 100 Players Online In the Battle Royal Mode\n“Battle Royale” mode: compare your general knowledge with up to 99 players online: the last man standing will be the greatest champion!\nNEW GAME MODES\n“Cooperative” mode: team up with up to 3 other players and give the right answer together.\n“Taking Turns” mode: compete with up to 9 other players in LAN by sharing the controller!\n“Free-For-All” mode: answer the most questions in a row to earn bonus points: the one with the largest amount of points in the end will win!"}