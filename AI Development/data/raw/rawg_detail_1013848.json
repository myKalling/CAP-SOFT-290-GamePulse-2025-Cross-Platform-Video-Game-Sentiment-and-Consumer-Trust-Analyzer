{"id": 1013848, "slug": "desktop-defender-2", "name": "Desktop Defender", "name_original": "Desktop Defender", "description": "<p><strong>Defend your desktop in this idle auto-battler that sits quietly in the corner of your screen.</strong></p><p>Fend off endless waves of enemies, upgrade your lone tower, and grow stronger across ascensions while you go about your day.</p><p> </p><h3>Level up and unlock</h3><p>Gain XP, level up, and earn rewards such as permanent upgrades, powerful loot, or new weapons.</p><h3>Hunt for loot</h3><p>Enemies drop rare gear with huge bonuses. Equip the best and create broken builds.</p><h3>Ascend and grow stronger</h3><p>Reset your run to earn Ascendium, unlocking cross-ascension upgrades that boost your progress.</p><h3>Always on, never in the way</h3><p>Runs in a small corner of your screen so you can work, browse, or game while defending.</p><h3>Customize your play</h3><p>Adjust size and position to fit your setup. Stay passive or play actively. It's up to you!</p>", "metacritic": null, "metacritic_platforms": [], "released": "2025-11-04", "tba": false, "updated": "2025-11-07T08:02:37", "background_image": "https://media.rawg.io/media/screenshots/541/541279253d07019694c8520936065350.jpg", "background_image_additional": "https://media.rawg.io/media/screenshots/c84/c846558d9b85e6856affa2dec3a9bc1b.jpg", "website": "", "rating": 0.0, "rating_top": 0, "ratings": [], "reactions": null, "added": 5, "added_by_status": {"owned": 4, "toplay": 1}, "playtime": 19, "screenshots_count": 10, "movies_count": 0, "creators_count": 0, "achievements_count": 80, "parent_achievements_count": 80, "reddit_url": "", "reddit_name": "", "reddit_description": "", "reddit_logo": "", "reddit_count": 0, "twitch_count": 0, "youtube_count": 0, "reviews_text_count": 0, "ratings_count": 0, "suggestions_count": 276, "alternative_names": [], "metacritic_url": "", "parents_count": 0, "additions_count": 0, "game_series_count": 0, "user_game": null, "reviews_count": 0, "c