_background": "https://media.rawg.io/media/games/0e3/0e32860e1a07282e4d03511e1851e06e.jpg"}, {"id": 92235, "name": "Adjustable Difficulty", "slug": "adjustable-difficulty", "language": "eng", "games_count": 1189, "image_background": "https://media.rawg.io/media/screenshots/562/562521586e68d39aae565ab7ea589368.jpg"}, {"id": 2629, "name": "mine", "slug": "mine", "language": "eng", "games_count": 1238, "image_background": "https://media.rawg.io/media/games/18f/18fba094d4ba0dda019131ea9b585446.jpg"}, {"id": 999, "name": "shark", "slug": "shark", "language": "eng", "games_count": 557, "image_background": "https://media.rawg.io/media/screenshots/c08/c086d3efff49671cddb47dead9c5cbd5_U2xV7Ni.jpg"}, {"id": 3187, "name": "break", "slug": "break", "language": "eng", "games_count": 429, "image_background": "https://media.rawg.io/media/screenshots/3b9/3b9fd1292aab6a3db6d95e7fca62558f.jpg"}, {"id": 82518, "name": "Job Simulator", "slug": "job-simulator-2", "language": "eng", "games_count": 203, "image_background": "https://media.rawg.io/media/screenshots/89b/89b9d7e7cab76ae85c2bdbc89d7b968d.jpg"}, {"id": 4814, "name": "gems", "slug": "gems", "language": "eng", "games_count": 356, "image_background": "https://media.rawg.io/media/screenshots/c29/c29582042cb618636e5816165616cd62_OSnnGXe.jpg"}, {"id": 1734, "name": "miner", "slug": "miner", "language": "eng", "games_count": 60, "image_background": "https://media.rawg.io/media/screenshots/fd3/fd33802ce0268fbec076f380ca20cdbb.jpg"}], "publishers": [{"id": 88905, "name": "Merge Conflict Studio", "slug": "merge-conflict-studio", "games_count": 2, "image_background": "https://media.rawg.io/media/screenshots/b1a/b1a241bf817ae3e490d9edd0849d04a8.jpg"}], "esrb_rating": null, "clip": null, "description_raw": "Grow your small gem business in this short, casual simulation miner, Gemporium! Manage your time wisely between mining gemstones, refining them for more profit, and selling them to awaiting customers. After your Grandmole goes on vacation, you’re in charge of running her shop, and you quickly learn it also comes with a price of massive debt. Now, on top of building your business, you must appease the Loan Shark without going broke!Gemporium features a timed day cycle where you have to balance completing tasks and running the gem store. Each day consists of:Explore deeper and deeper in the local mines to stock up on gems of different rarities. Utilize various mining tools to prevent cracks and maintain the highest quality product for your shop!Polish and prepare your recent finds in the mine to convert those lumps of rock into something collectors adore! Unrefined gemstones sell for way less than their refined counterparts, so make sure to visit the refinement table before you set up shop.Sell your stockpile of gems to eagerly awaiting customers, but make sure to keep their tastes in mind to maximize your profit and increase your shop's reputation! The shop is only open for a limited amount of time each day, so don't be late!Upgrade your tools, shop, and home to progress from being an anxious little mole to a master market manipulator.For fans of a more relaxed experience, there are multiple day speed options that modify how much you have to rush to meet objectives! Alternatively, you can activate Cozy Mode to turn off the daily timer entirely and play at your own pace."}