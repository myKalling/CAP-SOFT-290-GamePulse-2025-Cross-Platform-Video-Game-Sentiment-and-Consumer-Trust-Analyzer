ground": "https://media.rawg.io/media/screenshots/e94/e9403b3e50ac044b44f39f91dce23b85.jpg"}, {"id": 820, "name": "secrets", "slug": "secrets", "language": "eng", "games_count": 3486, "image_background": "https://media.rawg.io/media/screenshots/cd1/cd1dedeafe91fa1d9034dba0c3dcb1f7.jpg"}, {"id": 1709, "name": "work", "slug": "work", "language": "eng", "games_count": 9350, "image_background": "https://media.rawg.io/media/screenshots/c93/c93b6722c7dcf1ac6d237c1fd3ae3847.jpg"}, {"id": 1652, "name": "night", "slug": "night", "language": "eng", "games_count": 4512, "image_background": "https://media.rawg.io/media/screenshots/a71/a716436bd36cbea4979b0ad7ecae578d.jpg"}, {"id": 3068, "name": "future", "slug": "future", "language": "eng", "games_count": 3150, "image_background": "https://media.rawg.io/media/games/8dd/8dd95766d6f1dfcfe47128a82ed22699.jpg"}, {"id": 575, "name": "Logic", "slug": "logic", "language": "eng", "games_count": 6432, "image_background": "https://media.rawg.io/media/screenshots/706/70611f43244db868fe0dd435b7351746.jpg"}, {"id": 8234, "name": "fall", "slug": "fall", "language": "eng", "games_count": 3550, "image_background": "https://media.rawg.io/media/screenshots/1ae/1aef4421d7f96e4fb8bb8d121cd3e703_SS9Fznj.jpg"}, {"id": 2528, "name": "brain", "slug": "brain", "language": "eng", "games_count": 4214, "image_background": "https://media.rawg.io/media/screenshots/865/865964417247f8fa694bf60c36e2818b.jpg"}, {"id": 2863, "name": "darkness", "slug": "darkness", "language": "eng", "games_count": 490, "image_background": "https://media.rawg.io/media/games/1f2/1f283264816de6f464d7de144530e9b8.jpg"}, {"id": 92228, "name": "Stereo Sound", "slug": "stereo-sound", "language": "eng", "games_count": 2157, "image_background": "https://media.rawg.io/media/screenshots/50c/50ca35b80bd7a35a1a7d9fecdbcd6517_kJS1cIB.jpg"}, {"id": 92227, "name": "Custom Volume Controls", "slug": "custom-volume-controls", "language": "eng", "games_count": 3920, "image_background": "https://media.rawg.io/media/games/c14/c148c1e52dac195fd28158834360fb97.jpg"}, {"id": 2286, "name": "tower", "slug": "tower", "language": "eng", "games_count": 2504, "image_background": "https://media.rawg.io/media/screenshots/21e/21e42d3494bb420b6b1462d087c4dc58.jpg"}, {"id": 68059, "name": "Escape Room", "slug": "escape-room-2", "language": "eng", "games_count": 391, "image_background": "https://media.rawg.io/media/games/b2d/b2d4e1f3fc468c104efb7c5a576b4206.jpg"}, {"id": 92234, "name": "Adjustable Text Size", "slug": "adjustable-text-size", "language": "eng", "games_count": 314, "image_background": "https://media.rawg.io/media/games/e0f/e0fc6554b6c0b5cd95037858898a1cc8.jpg"}, {"id": 2680, "name": "child", "slug": "child", "language": "eng", "games_count": 438, "image_background": "https://media.rawg.io/media/screenshots/93c/93c07cde2a680d30dc3f220bceaa0500.jpg"}, {"id": 92229, "name": "Mouse Only Option", "slug": "mouse-only-option", "language": "eng", "games_count": 1915, "image_background": "https://media.rawg.io/media/games/cee/cee602d3edd8ba1348a4c6c775af5361.jpg"}, {"id": 2857, "name": "construction", "slug": "construction", "language": "eng", "games_count": 333, "image_background": "https://media.rawg.io/media/screenshots/968/9682bee17f677c9193125dd2fcadb8f0.jpg"}, {"id": 92230, "name": "Touch Only Option", "slug": "touch-only-option", "language": "eng", "games_count": 460, "image_background": "https://media.rawg.io/media/screenshots/53b/53bce679df0668826ebcb1d6ca030d94.jpg"}, {"id": 3875, "name": "man", "slug": "man", "language": "eng", "games_count": 233, "image_background": "https://media.rawg.io/media/screenshots/fdb/fdbd55073f801485473fd2b8ab60ad50.jpg"}, {"id": 91995, "name": "Квест-комната", "slug": "kvest-komnata", "language": "eng", "games_count": 149, "image_background": "https://media.rawg.io/media/screenshots/789/7892e4c24e13b57d48fec9233273bdac.jpg"}], "publishers": [{"id": 9353, "name": "Blue Brain Games", "slug": "blue-brain-games", "games_count": 12, "image_background": "https://media.rawg.io/media/screenshots/e79/e79f3394e394b25ae1bba55a949c34ff_5so30yv.jpg"}], "esrb_rating": null, "clip": null, "description_raw": "We are hard at work to bring you a brand-new adventure from Blue Brain Games, the creators of The House of Da Vinci. You can expect new handcrafted puzzles, hauntingly beautiful locations, and challenges for your brain’s gray (or blue) matter. You will be able to look at the world through the eyes of one of the most famous inventors, the father of electricity, the man behind alternating current, the science wizard, Nikola Tesla.\nYou will need to be industrious and peer under the surface to prevail.\nScience brings mysteries toward the light one by one, strips them of their secrets, and makes them part of something greater. It is true that some myths are rooted too deeply, are too resilient, and even seem like having a mind of their own as they resist men of science trying to shine the light of understanding. But in the end, science and mystery are anything but anathema to each other. On one stormy night, a person was brought to this world. A child of darkness and a child of light, full of mysteries and full of scientific curiosity, just starting to build a myth of their own.\nYou will explore the eerie abandoned industrial buildings of Nikola Tesla’s most ambitious facility in Wardenclyffe, which was meant to become an important city where the future is today and every societal process is improved upon by the principles of free wireless electrical energy.\nThrough the eyes of the man himself you’ll watch the important moments that lead to the construction and later to the fall of the famous Wardenclyffe Tower, and slowly uncover the mystery that left you stranded among deserted machines.\nFresh locations based on real places and plans of the enigmatic Nikola Tesla\nMysterious story from our take on the Progressive Era America\nNew dynamic approach to storytelling using flashbacks into the past\nUse a device that allows you to see and influence the flow of electricity\nNew handcrafted puzzles to challenge yourself"}