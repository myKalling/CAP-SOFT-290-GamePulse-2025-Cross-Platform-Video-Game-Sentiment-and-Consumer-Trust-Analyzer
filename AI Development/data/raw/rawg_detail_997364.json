d": 2232, "name": "journey", "slug": "journey", "language": "eng", "games_count": 2155, "image_background": "https://media.rawg.io/media/screenshots/387/3873e4dad2efab0da657e6df50739f5f.jpg"}, {"id": 49951, "name": "Automobile Sim", "slug": "automobile-sim", "language": "eng", "games_count": 1146, "image_background": "https://media.rawg.io/media/screenshots/b4f/b4f32ef81a17fc74c7764e76e965e639.jpg"}, {"id": 5559, "name": "elements", "slug": "elements", "language": "eng", "games_count": 1770, "image_background": "https://media.rawg.io/media/games/5ef/5ef5c47b65bf5f754080c3e34841f059.jpg"}, {"id": 2384, "name": "rock", "slug": "rock", "language": "eng", "games_count": 1649, "image_background": "https://media.rawg.io/media/screenshots/391/391698220e7b09846a03c278bce542c9.jpg"}, {"id": 1117, "name": "chaos", "slug": "chaos", "language": "eng", "games_count": 761, "image_background": "https://media.rawg.io/media/screenshots/34a/34ab311451a42830da586fe02c37fb59.jpg"}, {"id": 3584, "name": "characters", "slug": "characters", "language": "eng", "games_count": 1370, "image_background": "https://media.rawg.io/media/screenshots/f8a/f8ae8e28ab415496da50ddc05d2a6fa7.jpg"}, {"id": 2474, "name": "bomb", "slug": "bomb", "language": "eng", "games_count": 1666, "image_background": "https://media.rawg.io/media/screenshots/303/3033b7e609f1b1a5a42dcb399ab84122.jpeg"}, {"id": 1541, "name": "radio", "slug": "radio", "language": "eng", "games_count": 69, "image_background": "https://media.rawg.io/media/screenshots/76a/76af23337dd5910f54aad46226267810.jpg"}, {"id": 2609, "name": "vehicle", "slug": "vehicle", "language": "eng", "games_count": 405, "image_background": "https://media.rawg.io/media/games/39d/39db38dd46803566800c61f73ed4b3a7.jpg"}, {"id": 1451, "name": "english", "slug": "english", "language": "eng", "games_count": 392, "image_background": "https://media.rawg.io/media/screenshots/f0c/f0c622b59830b3a3deec394e8a3e0731.jpg"}, {"id": 1412, "name": "design", "slug": "design", "language": "eng", "games_count": 1952, "image_background": "https://media.rawg.io/media/screenshots/5e7/5e7afb93745afd0d401d4371b26be21d.jpg"}, {"id": 8529, "name": "luck", "slug": "luck", "language": "eng", "games_count": 1086, "image_background": "https://media.rawg.io/media/screenshots/02a/02a0df74f0a3447946cbfd07c9334691_J3hv5Wl.jpg"}, {"id": 7231, "name": "roll", "slug": "roll", "language": "eng", "games_count": 564, "image_background": "https://media.rawg.io/media/screenshots/926/926304a817e45a8bfad2991c19b04e0b_O1vu5ce.jpg"}, {"id": 8577, "name": "vehicles", "slug": "vehicles", "language": "eng", "games_count": 292, "image_background": "https://media.rawg.io/media/screenshots/a3f/a3f615d317f8675ab423343c3d6be912.jpg"}], "publishers": [{"id": 10691, "name": "Konami", "slug": "konami", "games_count": 879, "image_background": "https://media.rawg.io/media/games/594/59415e7fe99545bb303c108b19f38667.jpg"}], "esrb_rating": null, "clip": null, "description_raw": "Deliver At All Costs is a thrilling action game where destruction, absurdity and intrigue collide!\nThe year is 1959. A time of rock 'n' roll, polka dot dresses and the ever-looming dread of nuclear annihilation. Step into the shoes of Winston Green — a down-on-his-luck courier with a fiery temper and a mysterious past — as he delivers highly unconventional cargo, leaving a trail of havoc and chaos behind him, ensuring he does what it takes to Deliver At All Costs!\n\nWreak Havoc and Destruction in the Streets\nPlow through the city across highly destructible environments, wreaking havoc in a wide variety of vehicles. Take on bizarre deliveries and missions each with its own unique play style and mechanic. From delivering a giant flailing Marlin, to the disposal of a big bomb teetering on the edge of explosion, always expect the unexpected!\n\nJourney through a Dynamic World\nExplore an intricately designed world with large semi-open environments both on foot and in your vehicle. Be careful not to upset the citizens though - they will respond to your actions in the most unpredictable of ways…\n\nCome for the Chaos, Stay for the Story\nAmidst the chaos and destruction, embark on a story of mystery and intrigue divided into three acts, with a cast of distinct and memorable characters. Witness Winston’s journey as he spirals downward into the depths of insanity.\n\nThe Sights and Sounds of 1959\nImmerse yourself in the atmosphere of the 1950s with aesthetics and evocative music paying homage to the classic era. Featuring 1950s design elements, an original soundtrack, radio ads, English voice acting and a UI fitting of the times - all capturing the essence of what made the 1950s iconic!"}